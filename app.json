{
  "expo": {
    "name": "Del Rio FM San Francisco",
    "slug": "DelRioFM_Fresh",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "bundleIdentifier": "delriofm.sanfrancisco",
      "supportsTablet": true
    },
    "android": {
      "package": "delriofm.sanfrancisco",
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#252d39"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "04b4b38b-42a5-4a32-a05a-9a847e84eefe"
      }
    }
  }
}